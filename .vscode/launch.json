{
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "processCreateCommands": [
                "gdb-remote localhost:1234"
            ],
            "initCommands": [ // 根据是否需要对 main 前的 asm debug 决定
                "process handle SIGTRAP -s false"
            ],
            "name": "Debug 1",
            "program": "${workspaceFolder}/target/riscv64gc-unknown-none-elf/release/os"
        },
        {
            "name": "cppdbg",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/riscv64gc-unknown-none-elf/release/os",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set architecture to riscv:rv64",
                    "text": "set arch riscv:rv64",
                    "ignoreFailures": false
                },
            ],
            // RISC-V工具链中的gdb
            "miDebuggerPath": "/home/julyfun/app/riscv64-unknown-elf-gcc-8.3.0-2020.04.1-x86_64-linux-ubuntu14/bin/riscv64-unknown-elf-gdb",
            // gdb server 的地址端口
            "miDebuggerServerAddress": "localhost:1234"
        },
        {
            "name": "deepseek cppdbg",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/riscv64gc-unknown-none-elf/release/os",
            "miDebuggerServerAddress": "localhost:1234",
            "miDebuggerPath": "/home/julyfun/app/riscv64-unknown-elf-gcc-8.3.0-2020.04.1-x86_64-linux-ubuntu14/bin/riscv64-unknown-elf-gdb",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Set architecture",
                    "text": "set arch riscv:rv64",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}